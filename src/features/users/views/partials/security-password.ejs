<div class="sg-card">
    <div style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: var(--space-4);">
        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--bg-page); display: flex; align-items: center; justify-content: center; color: var(--accent-blue);">
            <i data-lucide="more-horizontal"></i>
        </div>
        <div>
            <h3 style="font-size: 1.1rem; margin-bottom: 4px;">Gestione Password</h3>
            <p>Ultima modifica: <%= passwordLastModified %></p>
        </div>
    </div>
    
    <button class="btn-sg btn-sg-outline" style="width: 100%;">Modifica Password</button>
</div>
