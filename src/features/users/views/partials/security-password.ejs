<%#
  Partial: security-password.ejs
  Card gestione password.
  Variabili: passwordLastChanged
%>

<div class="sg-card sg-password" id="password-section">
  <div class="sg-card__header">
    <h3 class="sg-card__title">
      <i class="bi bi-lock-fill"></i> Gestione Password
    </h3>
  </div>

  <div class="sg-password__info">
    <div class="sg-password__icon-wrap">
      <i class="bi bi-shield-lock"></i>
    </div>
    <div class="sg-password__text">
      <h4>Password corrente</h4>
      <p>Ultima modifica: <strong><%= passwordLastChanged %></strong></p>
    </div>
  </div>

  <div>
    <p style="font-size: 0.8rem; color: var(--sg-text-secondary); margin: 0 0 var(--sg-space-3);">
      <i class="bi bi-info-circle"></i>
      Si consiglia di cambiare la password ogni 3 mesi per una maggiore sicurezza.
    </p>
    <button class="sg-btn sg-btn--outline" type="button" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
      <i class="bi bi-pencil-square"></i> Modifica Password
    </button>
  </div>
</div>
