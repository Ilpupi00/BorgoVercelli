<div class="col-lg-3 col-xl-2 px-0">
    <div class="admin-sidebar">
        <div class="sidebar-header">
            <h5 class="text-white mb-3">
                <i class="bi bi-gear-fill me-2"></i> Menu Admin
            </h5>
        </div>
        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <!-- Sezione Contenuti -->
                <% if ([1, 2, 3, 5].includes(user.tipo_utente_id)) { %>
                <li class="nav-item">
                    <div class="nav-link section-header text-white" data-bs-toggle="collapse" data-bs-target="#menuContenuti" aria-expanded="false">
                        <i class="bi bi-file-earmark-text me-2"></i> Contenuti
                    </div>
                </li>
                <div class="collapse" id="menuContenuti">
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/notizie')) ? 'active' : '' %>" href="/admin/notizie">
                            <i class="bi bi-newspaper me-2"></i> Gestisci Notizie
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/eventi')) ? 'active' : '' %>" href="/admin/eventi">
                            <i class="bi bi-calendar-event me-2"></i> Gestisci Eventi
                        </a>
                    </li>
                    <% if ([1, 2, 3].includes(user.tipo_utente_id)) { %>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/galleria')) ? 'active' : '' %>" href="/admin/galleria">
                            <i class="bi bi-images me-2"></i> Gestisci Galleria
                        </a>
                    </li>
                    <% } %>
                    <% if ([1, 2, 3, 4].includes(user.tipo_utente_id)) { %>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/squadre')) ? 'active' : '' %>" href="/admin/squadre">
                            <i class="bi bi-people me-2"></i> Gestisci Squadre
                        </a>
                    </li>
                    <% } %>
                    <% if ([1, 2, 3, 5, 6].includes(user.tipo_utente_id)) { %>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.match(/^\/admin\/campi(\/|$)/)) ? 'active' : '' %>" href="/admin/campi">
                            <i class="bi bi-geo-alt me-2"></i> Gestisci Campi
                        </a>
                    </li>
                    <% } %>
                    <% if ([1, 2, 3].includes(user.tipo_utente_id)) { %>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.match(/^\/admin\/campionati(\/|$)/)) ? 'active' : '' %>" href="/admin/campionati">
                            <i class="bi bi-trophy me-2"></i> Gestisci Campionati
                        </a>
                    </li>
                    <% } %>
                    <% if (user.tipo_utente_id === 1) { %>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/pops')) ? 'active' : '' %>" href="/admin/pops">
                            <i class="bi bi-megaphone me-2"></i> Gestisci POPS
                        </a>
                    </li>
                    <% } %>
                </div>
                <% } else if (user.tipo_utente_id === 4) { %>
                <!-- Dirigente vede solo Squadre -->
                <li class="nav-item">
                    <div class="nav-link section-header text-white" data-bs-toggle="collapse" data-bs-target="#menuSquadre" aria-expanded="false">
                        <i class="bi bi-people me-2"></i> Squadre
                    </div>
                </li>
                <div class="collapse" id="menuSquadre">
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/squadre')) ? 'active' : '' %>" href="/admin/squadre">
                            <i class="bi bi-people me-2"></i> Gestisci Squadre
                        </a>
                    </li>
                </div>
                <% } else if (user.tipo_utente_id === 6) { %>
                <!-- Gestore Campo vede solo Campi -->
                <li class="nav-item">
                    <div class="nav-link section-header text-white" data-bs-toggle="collapse" data-bs-target="#menuCampi" aria-expanded="false">
                        <i class="bi bi-geo-alt me-2"></i> Campi
                    </div>
                </li>
                <div class="collapse" id="menuCampi">
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.match(/^\/admin\/campi(\/|$)/)) ? 'active' : '' %>" href="/admin/campi">
                            <i class="bi bi-geo-alt me-2"></i> Gestisci Campi
                        </a>
                    </li>
                </div>
                <% } %>

                <!-- Sezione Utenti (solo Admin) -->
                <% if (user.tipo_utente_id === 1) { %>
                <li class="nav-item mt-3">
                    <div class="nav-link section-header text-white" data-bs-toggle="collapse" data-bs-target="#menuUtenti" aria-expanded="false">
                        <i class="bi bi-people me-2"></i> Utenti
                    </div>
                </li>
                <div class="collapse" id="menuUtenti">
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/utenti')) ? 'active' : '' %>" href="/admin/utenti">
                            <i class="bi bi-person me-2"></i> Gestore Utenti
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/recensioni')) ? 'active' : '' %>" href="/admin/recensioni">
                            <i class="bi bi-star me-2"></i> Gestisci Recensioni
                        </a>
                    </li>
                </div>
                <% } %>

                <!-- Sezione Strumenti -->
                <li class="nav-item mt-3">
                    <div class="nav-link section-header text-white" data-bs-toggle="collapse" data-bs-target="#menuStrumenti" aria-expanded="false">
                        <i class="bi bi-wrench me-2"></i> Strumenti
                    </div>
                </li>
                <div class="collapse" id="menuStrumenti">
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/prenotazioni')) ? 'active' : '' %>" href="/admin/prenotazioni">
                            <i class="bi bi-card-checklist me-2"></i> Prenotazioni
                        </a>
                    </li>
                    <% if (user.tipo_utente_id === 1) { %>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/statistiche')) ? 'active' : '' %>" href="/admin/statistiche">
                            <i class="bi bi-bar-chart me-2"></i> Statistiche
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link submenu text-white <%= (currentPath && currentPath.startsWith('/admin/temi')) ? 'active' : '' %>" href="/admin/temi">
                            <i class="bi bi-palette me-2"></i> Gestione Temi
                        </a>
                    </li>
                    <% } %>
                </div>

                <!-- Torna al Sito -->
                <li class="nav-item mt-3">
                    <a class="nav-link text-warning site-link <%= (currentPath && currentPath.toLowerCase().startsWith('/homepage')) ? 'active' : '' %>" href="/homepage">
                        <i class="bi bi-house me-2"></i> Torna al Sito
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>