<%
  // Questo partial deve essere incluso UNA SOLA VOLTA nel <head>.
  // Usa un flag EJS per prevenire iniezioni duplicate sulla stessa pagina.
  if (typeof locals._themeIncluded === 'undefined') {
    locals._themeIncluded = true;
%>
<!-- ======================== SISTEMA TEMI ======================== -->

<!-- 0. Bootstrap immediato del tema: deve arrivare prima dei CSS per evitare FOUC -->
<script>
  (function() {
    var temaServer = '<%= typeof temaId !== "undefined" ? temaId : "light" %>';
    var VALID_THEMES = ['light', 'dark', 'sport', 'nature'];
    var THEME_BG = {
      'light':  '#ffffff',
      'dark':   '#0f1117',
      'sport':  '#F8F9FC',
      'nature': '#F7FEF9'
    };
    var temaCorrente = temaServer;

    try {
      var savedTheme = localStorage.getItem('site-theme-preference');
      if (savedTheme && VALID_THEMES.indexOf(savedTheme) !== -1) {
        temaCorrente = savedTheme;
      } else if (savedTheme === 'auto' && window.matchMedia) {
        temaCorrente = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    } catch (e) {
      // localStorage may be unavailable; keep server theme
    }

    var bg = THEME_BG[temaCorrente] || '#ffffff';
    document.documentElement.setAttribute('data-theme', temaCorrente);
    document.documentElement.style.colorScheme = temaCorrente === 'dark' ? 'dark' : 'light';
    document.documentElement.style.backgroundColor = bg;
    document.body && (document.body.style.backgroundColor = bg);
    document.cookie = 'tema=' + temaCorrente + '; path=/; max-age=2592000; SameSite=Lax';
    window.__BORGO_TEMA_BOOTSTRAP = temaCorrente;
  })();
</script>

<style id="theme-critical-style">
  /* Blocca FOUC: questo CSS viene eseguito PRIMA di qualsiasi file esterno */
  html {
    background-color: #ffffff;
  }

  html[data-theme="dark"],
  body[data-theme="dark"] {
    background-color: #0f1117;
    color-scheme: dark;
  }

  html[data-theme="light"],
  body[data-theme="light"] {
    background-color: #ffffff;
    color-scheme: light;
  }

  /* SPORT — Royal Navy: sfondo bianco-blu neutro */
  html[data-theme="sport"],
  body[data-theme="sport"] {
    background-color: #F8F9FC;
    color-scheme: light;
  }

  /* NATURE — Emerald Bloom: sfondo bianco-verde freschissimo */
  html[data-theme="nature"],
  body[data-theme="nature"] {
    background-color: #F7FEF9;
    color-scheme: light;
  }

  body {
    background-color: inherit;
  }
</style>


<!-- 1. CSS variabili base (fallback se il middleware non ha ancora girato) -->
<link rel="stylesheet" href="/assets/styles/theme-variables.css?v=3.0">

<!-- 2. Dark theme overrides globali (ora include anche sport e nature) -->
<link rel="stylesheet" href="/assets/styles/theme-dark.css?v=3.0">

<!-- 3. CSS variabili dinamico iniettato dal middleware (server-side, previene FOUC) -->
<% if (typeof temaCSS !== 'undefined' && temaCSS) { %>
<style id="dynamic-theme-style"><%= temaCSS %></style>
<% } %>

<!-- 4. Flag logged per il client-switcher -->
<script>
  window.__BORGO_LOGGED = <%= typeof isLogged !== 'undefined' ? isLogged : false %>;
  window.__BORGO_TEMA   = window.__BORGO_TEMA_BOOTSTRAP || '<%= typeof temaId !== "undefined" ? temaId : "light" %>';
</script>

<!-- 5. Client-side switcher (gestisce cambio tema senza reload) -->
<script src="/assets/scripts/client-tema-switcher.js" defer></script>

<!-- 6. Web App Manifest -->
<link rel="manifest" href="/manifest.json">
<!-- ============================================================= -->
<% } %>
